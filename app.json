{
  "expo": {
    "name": "Smart Pill Box",
    "slug": "smart-pill-box",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "smartpillbox",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.smartpillbox.app",
      "permissions": ["SCHEDULE_EXACT_ALARM"],
      "adaptiveIcon": {
        "backgroundColor": "#E9F7F0"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b169177-a33f-4399-a3ef-9a805dc7c1c5"
      }
    }
  }
}
